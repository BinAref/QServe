# ---------------------------------------------------------------------------
# License server (vendor side). Never deployed to a restaurant.
# ---------------------------------------------------------------------------
QSERVE_LS_HOST=0.0.0.0
QSERVE_LS_PORT=8090
QSERVE_LS_DATA_DIR=./data/license-server
# Generated by `npm run keygen`. The private half must never ship with the app.
QSERVE_LS_SIGNING_KEY_FILE=./secrets/signing-key.json
QSERVE_LS_LICENSE_YEAR=2026
# Bootstrap developer account. Omit the password and one is generated and
# printed once at first boot.
QSERVE_LS_ADMIN_USERNAME=developer
# QSERVE_LS_ADMIN_PASSWORD=
QSERVE_LS_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Restaurant server (runs on the restaurant's own PC).
# ---------------------------------------------------------------------------
QSERVE_DATA_DIR=./data/restaurant
# Loopback-only management console. Never bind this to the LAN.
QSERVE_ADMIN_PORT=7010
# LAN listener for diners and staff terminals. Started only once a licence is
# active; before that the port stays closed.
QSERVE_LAN_PORT=7020
QSERVE_LAN_HOST=0.0.0.0
# Where the app reaches the vendor. Used for activation and transfer only.
QSERVE_LICENSE_SERVER_URL=http://localhost:8090
# Hostname baked into printed QR codes. Prefer a stable mDNS name over an IP so
# a change of computer does not mean reprinting every table card.
# QSERVE_PUBLIC_HOST=qserve-rest-000123.local
# Developer mode (spec §30). Off in every packaged build. It unlocks one thing:
# authoring the language and theme packs that SHIP WITH THE PRODUCT — the files
# in locales/ and themes/. A restaurant never needs this; it adds its own
# languages and themes from Console → Languages and Console → Themes.
# QSERVE_DEVELOPER_MODE=true
#
# Prices and contact details are not configured here. The vendor writes them in
# the vendor console and every restaurant fetches them — see docs/LICENSING.md §7.
