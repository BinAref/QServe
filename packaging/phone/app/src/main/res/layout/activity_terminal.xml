<?xml version="1.0" encoding="utf-8"?>
<!--
  Pointing a device at its restaurant.

  Seen once per device by somebody standing in a kitchen holding a printed card,
  and then never again. So it is ordered by what that person is about to do, and
  weighted so the thing they came for is the only thing with any weight:

    the mark and the name        who this is
    a headline and one line      what to do
    Scan  — a filled pill        the action. Nothing else on screen is that shape.
    or type it                   the way round it, named so the box below is not
    a box and a plain Connect    mistaken for something that must be filled in
    a note                       what has to be true, small, at the bottom
    language and theme           quiet, last, and only ever touched once

  Three stacked rectangles of equal weight is what this was, and an eye has to
  read all three to find the one that matters. There is one rectangle now.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp">

            <!-- The mark and the name on one line: a logo with nothing beside it
                 is decoration, a logo with its name is identification. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_brand"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/brand_name"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />
            </LinearLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/address_title"
                android:textColor="@color/text"
                android:textSize="27sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:id="@+id/intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/address_intro"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.4" />

            <!-- Raised, not outlined. The border it used to carry sat inside the
                 page's own edge and around two more of its own. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingHorizontal="18dp"
                android:paddingVertical="20dp"
                android:elevation="3dp">

                <Button
                    android:id="@+id/scan"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_button_primary"
                    android:drawableStart="@drawable/ic_scan"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="@string/scan_button"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_contrast"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0" />

                <LinearLayout
                    android:id="@+id/or_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:text="@string/or_type_it"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/border" />
                </LinearLayout>

                <!-- `addStatesFromChildren` puts the focus ring on the box when
                     the caret is in the field: the background is on this row and
                     the focus is on the EditText inside it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:addStatesFromChildren="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="6dp">

                    <EditText
                        android:id="@+id/address"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:autofillHints="none"
                        android:importantForAutofill="no"
                        android:hint="@string/address_hint"
                        android:inputType="textUri"
                        android:imeOptions="actionGo"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted"
                        android:textCursorDrawable="@null"
                        android:textSize="16sp"
                        android:textDirection="ltr" />

                    <ImageButton
                        android:id="@+id/paste"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_field_action"
                        android:contentDescription="@string/paste"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_paste" />

                    <ImageButton
                        android:id="@+id/clear"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_field_action"
                        android:contentDescription="@string/clear"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_clear"
                        android:visibility="gone" />
                </LinearLayout>

                <Button
                    android:id="@+id/connect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_ghost"
                    android:paddingHorizontal="24dp"
                    android:text="@string/connect"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/needs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/address_needs"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4" />

            <!-- Language and theme. Both follow the device until told otherwise,
                 and both are dropdowns listing names — no flags, because a flag
                 is a country and Arabic is not a country. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="@string/language" />

                    <TextView
                        android:id="@+id/language"
                        style="@style/Dropdown"
                        android:drawableEnd="@drawable/ic_chevron" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="@string/theme" />

                    <TextView
                        android:id="@+id/theme"
                        style="@style/Dropdown"
                        android:drawableEnd="@drawable/ic_chevron" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
