<?xml version="1.0" encoding="utf-8"?>
<!-- One field and one button, centred. Nothing else belongs on a lock screen:
     everything it could show is the thing it is there to keep back. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="48dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_brand"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/lock_title"
            android:textColor="@color/text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_input"
            android:hint="@string/lock_hint"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:imeOptions="actionGo"
            android:letterSpacing="0.35"
            android:maxLength="32"
            android:paddingHorizontal="18dp"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textCursorDrawable="@null"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lock_wrong"
            android:textAlignment="center"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/unlock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/lock_unlock"
            android:textAllCaps="false"
            android:textColor="@color/primary_contrast"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
