<?xml version="1.0" encoding="utf-8"?>
<!-- The sheet a dropdown opens onto. The platform's own is a sharp-cornered
     slab in a colour that belongs to neither theme; this one is the product's
     surface with the product's corner. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/border" />
</shape>
