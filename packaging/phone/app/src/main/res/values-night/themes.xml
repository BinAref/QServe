<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The same theme with the dark palette. Only the parent and the status-bar
      icon flags differ; every colour is a token that `values-night/colors.xml`
      has already swapped.
    -->
    <style name="Theme.QServe" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:textColorHighlight">@color/border_strong</item>
    </style>
</resources>
