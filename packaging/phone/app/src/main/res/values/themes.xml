<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The shell's theme, light.

      Still deliberately plain — the restaurant's own theme is served by the page
      inside the WebView, and anything this shell paints over it would fight it.
      What it does is match: the colours are the product's own, and the dark
      variant in `values-night/` is the same style with the other palette, so a
      device set to dark gets a dark setup screen without a line of code.
    -->
    <style name="Theme.QServe" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:textColorHighlight">@color/border_strong</item>
        <!-- Dropdowns open onto the product's own surface, not the
             platform's sharp-cornered slab. -->
        <item name="android:popupMenuStyle">@style/QServePopup</item>
        <item name="android:textAppearanceLargePopupMenu">@style/QServePopupText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/QServePopupText</item>
        <!-- Dark icons in the status bar, because the bar is now light. The
             night variant leaves these out and gets light icons. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
      A dropdown: the control the language and the theme are both chosen with.
      Names only, no flags — a flag is a country, and Arabic is not a country.
    -->
    <style name="Dropdown">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_dropdown</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="QServePopup" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">14dp</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <style name="QServePopupText" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!--
      The scanner. Its system bars are black whatever the theme is, because
      what is behind them is a camera preview and a light status bar over a
      dark kitchen is a white stripe with nothing to do with the app.
    -->
    <style name="Theme.QServe.Camera" parent="@style/Theme.QServe">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
