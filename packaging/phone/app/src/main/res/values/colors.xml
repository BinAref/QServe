<?xml version="1.0" encoding="utf-8"?>
<!--
  The light palette, from `themes/light.json`.

  These are the product's own tokens rather than a second set invented for the
  shell. The dark ones live in `values-night/colors.xml`, and Android swaps
  between the two files on its own — so nothing in the layouts or the code names
  a colour twice, and adding a third theme would mean one more file and no other
  change.
-->
<resources>
    <color name="background">#F2F4F8</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_alt">#E9EDF4</color>

    <color name="text">#0F1419</color>
    <color name="muted">#566072</color>

    <color name="primary">#1558D6</color>
    <color name="primary_contrast">#FFFFFF</color>

    <color name="border">#DDE2EA</color>
    <color name="border_strong">#BCC5D4</color>
    <color name="danger">#C8232C</color>

    <color name="ripple">#1F1558D6</color>
    <color name="scrim">#33FFFFFF</color>
</resources>
