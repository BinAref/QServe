<?xml version="1.0" encoding="utf-8"?>
<!--
  The product's own palette, not a second one invented for the shell.

  These are the tokens from `themes/dark.json` — the theme the WebView is about
  to paint with. The setup screen is the only thing in this app a person sees
  that the restaurant's server did not draw, and it should not be the one screen
  that looks like it came from somewhere else.
-->
<resources>
    <color name="background">#0B0F16</color>
    <color name="surface">#131923</color>
    <color name="surface_alt">#1B2331</color>

    <color name="text">#E8EEF7</color>
    <color name="muted">#97A5B8</color>

    <color name="primary">#5AA2FF</color>
    <!-- Text on top of the primary colour. Dark on purpose: #5AA2FF is a light
         blue, and white on it fails contrast at button-label size. -->
    <color name="primary_contrast">#06121F</color>
    <color name="primary_pressed">#4790EC</color>

    <color name="border">#232C3A</color>
    <color name="border_strong">#354153</color>
    <color name="danger">#FF6B62</color>

    <color name="ripple">#1F5AA2FF</color>
    <color name="scrim">#B3020610</color>
</resources>
