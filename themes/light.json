{
  "$schema": "qserve.theme.v1",
  "id": "light",
  "name": "Light",
  "colorScheme": "light",
  "author": "QServe",
  "version": "1.0.0",
  "tokens": {
    "color": {
      "background": "#f2f4f8",
      "surface": "#ffffff",
      "surfaceAlt": "#e9edf4",
      "overlay": "rgb(12 18 32 / 0.45)",
      "primary": "#1558d6",
      "primaryContrast": "#ffffff",
      "secondary": "#4a5768",
      "secondaryContrast": "#ffffff",
      "text": "#0f1419",
      "textMuted": "#566072",
      "textInverse": "#ffffff",
      "border": "#dde2ea",
      "borderStrong": "#bcc5d4",
      "success": "#127a37",
      "warning": "#a86a00",
      "error": "#c8232c",
      "info": "#0b64c9",
      "focusRing": "#1558d6",
      "lit": "#1558d6",
      "litTrail": "#35b6ff"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "14px",
      "lg": "22px",
      "xl": "34px",
      "xxl": "52px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "pill": "999px"
    },
    "typography": {
      "fontFamilyBase": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Naskh Arabic', Arial, sans-serif",
      "fontFamilyDisplay": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Naskh Arabic', Arial, sans-serif",
      "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "sizeXs": "12px",
      "sizeSm": "13px",
      "sizeMd": "15px",
      "sizeLg": "18px",
      "sizeXl": "24px",
      "sizeXxl": "34px",
      "weightRegular": "400",
      "weightMedium": "600",
      "weightBold": "700",
      "lineHeightTight": "1.25",
      "lineHeightNormal": "1.55"
    },
    "shadow": {
      "sm": "0 1px 2px rgb(16 24 40 / 0.06)",
      "md": "0 6px 16px rgb(16 24 40 / 0.10)",
      "lg": "0 18px 40px rgb(16 24 40 / 0.16)"
    },
    "motion": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms",
      "easeStandard": "cubic-bezier(0.2, 0, 0.2, 1)",
      "easeEntrance": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "easeExit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "easeSpring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "component": {
      "button": {
        "radius": "{radius.md}",
        "paddingX": "{spacing.md}",
        "paddingY": "{spacing.sm}"
      },
      "card": {
        "radius": "{radius.lg}",
        "padding": "{spacing.lg}",
        "shadow": "{shadow.sm}"
      },
      "input": {
        "radius": "{radius.md}",
        "borderColor": "{color.border}",
        "background": "{color.surface}"
      },
      "nav": {
        "background": "{color.surface}",
        "text": "{color.text}",
        "activeBackground": "{color.surfaceAlt}"
      }
    }
  }
}
