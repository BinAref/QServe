{
  "$schema": "qserve.theme.v1",
  "id": "elegant",
  "name": "Elegant",
  "colorScheme": "dark",
  "author": "QServe",
  "version": "1.0.0",
  "tokens": {
    "color": {
      "background": "#12100e",
      "surface": "#1b1815",
      "surfaceAlt": "#241f1a",
      "overlay": "rgb(0 0 0 / 0.7)",
      "primary": "#c9a227",
      "primaryContrast": "#12100e",
      "secondary": "#8d7b5f",
      "secondaryContrast": "#12100e",
      "text": "#f0eae0",
      "textMuted": "#a2968a",
      "textInverse": "#12100e",
      "border": "#332c24",
      "borderStrong": "#4a4034",
      "success": "#7fae5c",
      "warning": "#d9a441",
      "error": "#d1584f",
      "info": "#7ba6c4",
      "focusRing": "#c9a227",
      "lit": "#c9a227",
      "litTrail": "#f0e0a8"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "14px",
      "lg": "22px",
      "xl": "34px",
      "xxl": "52px"
    },
    "radius": {
      "sm": "2px",
      "md": "4px",
      "lg": "6px",
      "pill": "999px"
    },
    "typography": {
      "fontFamilyBase": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Naskh Arabic', Arial, sans-serif",
      "fontFamilyDisplay": "Georgia, 'Noto Naskh Arabic', serif",
      "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "sizeXs": "12px",
      "sizeSm": "14px",
      "sizeMd": "16px",
      "sizeLg": "20px",
      "sizeXl": "26px",
      "sizeXxl": "34px",
      "weightRegular": "400",
      "weightMedium": "600",
      "weightBold": "700",
      "lineHeightTight": "1.25",
      "lineHeightNormal": "1.55"
    },
    "shadow": {
      "sm": "0 1px 3px rgb(0 0 0 / 0.5)",
      "md": "0 6px 18px rgb(0 0 0 / 0.55)",
      "lg": "0 18px 44px rgb(0 0 0 / 0.65)"
    },
    "motion": {
      "fast": "160ms",
      "normal": "260ms",
      "slow": "420ms",
      "easeStandard": "cubic-bezier(0.2, 0, 0.2, 1)",
      "easeEntrance": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "easeExit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "easeSpring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "component": {
      "button": {
        "radius": "{radius.md}",
        "paddingX": "{spacing.md}",
        "paddingY": "{spacing.sm}"
      },
      "card": {
        "radius": "{radius.lg}",
        "padding": "{spacing.lg}",
        "shadow": "{shadow.sm}"
      },
      "input": {
        "radius": "{radius.md}",
        "borderColor": "{color.border}",
        "background": "{color.surface}"
      },
      "nav": {
        "background": "{color.surface}",
        "text": "{color.text}",
        "activeBackground": "{color.surfaceAlt}"
      }
    }
  }
}
