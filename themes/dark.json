{
  "$schema": "qserve.theme.v1",
  "id": "dark",
  "name": "Dark",
  "colorScheme": "dark",
  "author": "QServe",
  "version": "1.0.0",
  "tokens": {
    "color": {
      "background": "#0b0f16",
      "surface": "#131923",
      "surfaceAlt": "#1b2331",
      "overlay": "rgb(2 6 12 / 0.7)",
      "primary": "#5aa2ff",
      "primaryContrast": "#06121f",
      "secondary": "#93a4bb",
      "secondaryContrast": "#06121f",
      "text": "#e8eef7",
      "textMuted": "#97a5b8",
      "textInverse": "#0b0f16",
      "border": "#232c3a",
      "borderStrong": "#354153",
      "success": "#4cc46a",
      "warning": "#e0aa3e",
      "error": "#ff6b62",
      "info": "#6cb4ff",
      "focusRing": "#5aa2ff",
      "lit": "#5aa2ff",
      "litTrail": "#a06bff"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "14px",
      "lg": "22px",
      "xl": "34px",
      "xxl": "52px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "pill": "999px"
    },
    "typography": {
      "fontFamilyBase": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Naskh Arabic', Arial, sans-serif",
      "fontFamilyDisplay": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Naskh Arabic', Arial, sans-serif",
      "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "sizeXs": "12px",
      "sizeSm": "13px",
      "sizeMd": "15px",
      "sizeLg": "18px",
      "sizeXl": "24px",
      "sizeXxl": "34px",
      "weightRegular": "400",
      "weightMedium": "600",
      "weightBold": "700",
      "lineHeightTight": "1.25",
      "lineHeightNormal": "1.55"
    },
    "shadow": {
      "sm": "0 1px 2px rgb(0 0 0 / 0.5)",
      "md": "0 8px 20px rgb(0 0 0 / 0.55)",
      "lg": "0 22px 48px rgb(0 0 0 / 0.65)"
    },
    "motion": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms",
      "easeStandard": "cubic-bezier(0.2, 0, 0.2, 1)",
      "easeEntrance": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "easeExit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "easeSpring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "component": {
      "button": {
        "radius": "{radius.md}",
        "paddingX": "{spacing.md}",
        "paddingY": "{spacing.sm}"
      },
      "card": {
        "radius": "{radius.lg}",
        "padding": "{spacing.lg}",
        "shadow": "{shadow.sm}"
      },
      "input": {
        "radius": "{radius.md}",
        "borderColor": "{color.border}",
        "background": "{color.surface}"
      },
      "nav": {
        "background": "{color.surface}",
        "text": "{color.text}",
        "activeBackground": "{color.surfaceAlt}"
      }
    }
  }
}
