{
  "$schema": "qserve.theme.v1",
  "id": "dark",
  "name": "Dark",
  "colorScheme": "dark",
  "author": "QServe",
  "version": "1.0.0",
  "tokens": {
    "color": {
      "background": "#0d1117",
      "surface": "#161b22",
      "surfaceAlt": "#1f2630",
      "overlay": "rgb(0 0 0 / 0.65)",
      "primary": "#4493f8",
      "primaryContrast": "#06111f",
      "secondary": "#8b949e",
      "secondaryContrast": "#06111f",
      "text": "#e6edf3",
      "textMuted": "#8b949e",
      "textInverse": "#0d1117",
      "border": "#2a323d",
      "borderStrong": "#3d4753",
      "success": "#3fb950",
      "warning": "#d29922",
      "error": "#f85149",
      "info": "#58a6ff",
      "focusRing": "#4493f8"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "14px",
      "lg": "22px",
      "xl": "34px",
      "xxl": "52px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "pill": "999px"
    },
    "typography": {
      "fontFamilyBase": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Naskh Arabic', Arial, sans-serif",
      "fontFamilyDisplay": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Naskh Arabic', Arial, sans-serif",
      "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "sizeXs": "12px",
      "sizeSm": "13px",
      "sizeMd": "15px",
      "sizeLg": "18px",
      "sizeXl": "24px",
      "sizeXxl": "34px",
      "weightRegular": "400",
      "weightMedium": "600",
      "weightBold": "700",
      "lineHeightTight": "1.25",
      "lineHeightNormal": "1.55"
    },
    "shadow": {
      "sm": "0 1px 2px rgb(0 0 0 / 0.4)",
      "md": "0 4px 14px rgb(0 0 0 / 0.5)",
      "lg": "0 16px 40px rgb(0 0 0 / 0.6)"
    },
    "motion": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms",
      "easeStandard": "cubic-bezier(0.2, 0, 0.2, 1)",
      "easeEntrance": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "easeExit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "easeSpring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "component": {
      "button": {
        "radius": "{radius.md}",
        "paddingX": "{spacing.md}",
        "paddingY": "{spacing.sm}"
      },
      "card": {
        "radius": "{radius.lg}",
        "padding": "{spacing.lg}",
        "shadow": "{shadow.sm}"
      },
      "input": {
        "radius": "{radius.md}",
        "borderColor": "{color.border}",
        "background": "{color.surface}"
      },
      "nav": {
        "background": "{color.surface}",
        "text": "{color.text}",
        "activeBackground": "{color.surfaceAlt}"
      }
    }
  }
}
